{
  "name": "dsh-stock-quotes-plus",
  "version": "3.0.2",
  "description": "DeepSeek Harness sidebar and optional ticker for Longbridge market data, with the stock_quote agent tool.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "stock",
    "quotes",
    "a-share",
    "longbridge"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangjh0127/dsh-stock-quotes-plus.git"
  },
  "homepage": "https://github.com/yangjh0127/dsh-stock-quotes-plus#readme",
  "bugs": {
    "url": "https://github.com/yangjh0127/dsh-stock-quotes-plus/issues"
  },
  "icon": "./icon.svg",
  "meta": {
    "title": "数据面板",
    "description": "可配置的自定义数据面板：侧边栏入口、列表定时自动刷新，显示名称可在设置中修改。"
  },
  "scripts": {
    "test": "node tests/meta.test.mjs && node tests/quotes.test.mjs && node tests/render.test.mjs && node tests/client.test.mjs",
    "prepublishOnly": "npm test",
    "check:release": "node scripts/check-release.mjs",
    "lint": "eslint client.js quotes.js index.js oauth.js market-routes.js market-calendar.js scripts/authorize.mjs",
    "pack:check": "npm pack --dry-run",
    "authorize": "node scripts/authorize.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./quotes": "./quotes.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./data/*.json": "./data/*.json"
  },
  "files": [
    "index.js",
    "quotes.js",
    "LICENSE-ticker",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "data/*.json",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md",
    "oauth.js",
    "market-routes.js",
    "scripts/authorize.mjs",
    "market-calendar.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5"
  },
  "dependencies": {
    "longbridge": "5.4.0"
  }
}
